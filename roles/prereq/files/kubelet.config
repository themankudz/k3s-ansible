apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
shutdownGracePeriod: 75s
shutdownGracePeriodCriticalPods: 25s
# Pull one image at a time per node instead of unbounded parallel pulls.
# Prevents a mass ArgoCD sync (many images at once, across every node) from
# bursting concurrent requests at Harbor's ghcr.io/docker.io pull-through
# caches and tripping upstream rate-limiting mid-transfer.
serializeImagePulls: true
# Eviction thresholds - kubelet evicts lowest-priority pods first.
# Longhorn pods use priorityClass longhorn-critical (value: 1,000,000,000)
# so they are only evicted after all regular workloads are gone.
evictionHard:
  memory.available: "300Mi"
  nodefs.available: "5%"
evictionSoft:
  memory.available: "500Mi"
  nodefs.available: "10%"
evictionSoftGracePeriod:
  memory.available: "2m"
  nodefs.available: "1m30s"
evictionMaxPodGracePeriod: 60
