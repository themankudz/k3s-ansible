# Hermes' OLLAMA_BASE_URL convention includes the /v1 (OpenAI-compatible) suffix,
# matching config.yaml model.base_url. config.yaml wins by precedence; this is
# kept consistent so the two can never disagree.
# (Context window is handled by model.ollama_num_ctx in config.yaml, not here.)
OLLAMA_BASE_URL={{ hermes_ollama_base_url }}/v1
{% if hermes_telegram_bot_token | length > 0 %}
TELEGRAM_BOT_TOKEN={{ hermes_telegram_bot_token }}
{% endif %}
{% if hermes_telegram_allowed_users | length > 0 %}
# Bot access control — only these Telegram user IDs may talk to the gateway (comma-separated).
TELEGRAM_ALLOWED_USERS={{ hermes_telegram_allowed_users }}
{% endif %}
{% if hermes_perplexity_api_key | length > 0 %}
PERPLEXITY_API_KEY={{ hermes_perplexity_api_key }}
{% endif %}
{% if hermes_openai_api_key | length > 0 %}
# Cloud heavy/delegation tier (D9). config.yaml's delegation.api_key references this as ${OPENAI_API_KEY}.
OPENAI_API_KEY={{ hermes_openai_api_key }}
{% endif %}
{% if hermes_honcho_api_key | length > 0 %}
# Honcho memory provider JWT. The plugin reads apiKey from honcho.json OR this
# env var; we keep the secret here (0600) so the 0644 honcho.json stays clean.
HONCHO_API_KEY={{ hermes_honcho_api_key }}
{% endif %}
{% if hermes_n8n_enabled %}
N8N_BASE_URL={{ hermes_n8n_base_url }}
{% endif %}
{% if hermes_n8n_api_key | length > 0 %}
N8N_API_KEY={{ hermes_n8n_api_key }}
{% endif %}
{% if hermes_hass_mcp_token | length > 0 %}
HASS_MCP_TOKEN={{ hermes_hass_mcp_token }}
{% endif %}
{% if hermes_github_mcp_token | length > 0 %}
GITHUB_MCP_TOKEN={{ hermes_github_mcp_token }}
{% endif %}
