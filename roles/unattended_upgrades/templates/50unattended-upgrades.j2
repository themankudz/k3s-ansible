// Managed by Ansible (roles/unattended_upgrades) — do not edit by hand.

Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}";
    "${distro_id}:${distro_codename}-security";
    "${distro_id}ESMApps:${distro_codename}-apps-security";
    "${distro_id}ESM:${distro_codename}-infra-security";
    "${distro_id}:${distro_codename}-updates";
};

Unattended-Upgrade::Remove-Unused-Kernel-Packages "{{ uu_remove_unused_kernel_packages | bool | lower }}";
Unattended-Upgrade::Remove-New-Unused-Dependencies "{{ uu_remove_unused_dependencies | bool | lower }}";
Unattended-Upgrade::Remove-Unused-Dependencies "{{ uu_remove_unused_dependencies | bool | lower }}";

Unattended-Upgrade::Automatic-Reboot "{{ uu_automatic_reboot | bool | lower }}";
{% if uu_automatic_reboot | bool %}
Unattended-Upgrade::Automatic-Reboot-Time "{{ uu_automatic_reboot_time }}";
{% endif %}
{% if unattended_upgrades_mail | length > 0 %}

Unattended-Upgrade::Mail "{{ unattended_upgrades_mail }}";
Unattended-Upgrade::MailReport "{{ unattended_upgrades_mail_trigger }}";
{% endif %}
