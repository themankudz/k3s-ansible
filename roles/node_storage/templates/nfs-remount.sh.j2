#!/bin/bash
# Auto-generated by Ansible — remounts stale NFS shares.
# Runs periodically via nfs-remount.timer.
set -euo pipefail

{% for mount in node_storage_nfs_mounts %}
mountpoint="{{ mount.mountpoint }}"
if findmnt "$mountpoint" > /dev/null 2>&1; then
    if ! timeout 5 stat "$mountpoint" > /dev/null 2>&1; then
        logger -t nfs-remount "Stale mount detected: $mountpoint — remounting"
        umount -l "$mountpoint" 2>/dev/null || true
        if mount "$mountpoint"; then
            logger -t nfs-remount "Successfully remounted: $mountpoint"
        else
            logger -t nfs-remount "ERROR: Failed to remount: $mountpoint"
        fi
    fi
fi
{% endfor %}
